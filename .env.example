# Google app passwords (16 chars, spaces ignored). Never commit the real .env.
PRIMARY_APP_PASSWORD=
PEER1_APP_PASSWORD=
PEER2_APP_PASSWORD=
PEER3_APP_PASSWORD=
PEER4_APP_PASSWORD=
PEER5_APP_PASSWORD=

# Only needed when llm.provider is "api"
ANTHROPIC_API_KEY=

# Alerting. Test with: python -m warmup alert-test
ALERT_WEBHOOK_URL=
# Dead-man's switch. Pinged after each successful tick; the monitor alerts you when the pings stop
# (process dead, laptop asleep, ticks failing), which nothing inside the process can tell you.
HEARTBEAT_URL=
